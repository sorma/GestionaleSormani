{
  "name": "@gestionale/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "smoke:ordini": "npm run build && node scripts/smoke-order-flow.mjs",
    "smoke:preventivi": "npm run build && node scripts/smoke-preventivi.mjs",
    "smoke:lavori": "npm run build && node scripts/smoke-lavori.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "prisma": "6.12.0",
    "tsx": "latest",
    "typescript": "5.9.3"
  }
}
